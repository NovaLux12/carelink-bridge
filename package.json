{
  "name": "carelink-bridge",
  "version": "0.2.0",
  "description": "Bridge that sends Medtronic CareLink pump and CGM data to Nightscout by simulating the CareLink mobile app's OAuth2 authentication and API calls.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "login": "tsx src/login.ts",
    "doctor": "tsx src/doctor.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "medtronic",
    "minimed",
    "carelink",
    "cgm",
    "nightscout",
    "diabetes"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.5",
    "qs": "^6.16.0",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qs": "^6.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
