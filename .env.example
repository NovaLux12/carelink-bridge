CARELINK_USERNAME=your-carelink-username
CARELINK_PASSWORD=your-carelink-password
API_SECRET=your-nightscout-api-secret
NS=https://your-nightscout-site.example.com
# MMCONNECT_SERVER=EU
# CARELINK_DATA_PATH=auto  # auto | cumulus | legacy. auto tries display/message then falls back to the legacy chain.
# CARELINK_APP_VERSION=3.8.0  # appVersion in the display/message body. Must be >= 3.7 or the server answers `206 Upgrade application` and no data.
# CARELINK_ASSUME_TIMEZONE=   # IANA zone, e.g. Europe/London. Used when CareLink sends no usable clientTimeZoneName.
                            # Without it an unzoned reading is interpreted as UTC — a UK user in BST gets every
                            # value shifted an hour, and the warning that says so is logger.log(), i.e. invisible
                            # at the default CARELINK_QUIET=true.
# MMCONNECT_COUNTRYCODE=gb    # ISO country code sent to CareLink. Also drives doctor's `CareLink region`
                           # check, which cross-references it against the discovery document's country→region
                           # table — so a mismatch with MMCONNECT_SERVER is reported before login.
# MMCONNECT_LANGCODE=en
# MMCONNECT_SERVERNAME=     # pin the CareLink hostname explicitly, instead of the EU/US default. Leave blank unless you need it.
# CARELINK_INTERVAL=300
# CARELINK_SGV_LIMIT=24
# CARELINK_QUIET=true       # only the literal `false` enables verbose logging; `0`/`no`/`yes` all mean quiet,
                         # and an empty value counts as unset.
# LOG_FORMAT=pretty          # pretty (human) or json (one JSON object per line, for Loki/journalctl -o json)
# CARELINK_PATIENT=
# CARELINK_STATE_FILE=       # default: <deploy-dir>/state.json (persistent circuit + last-success state, mode 600)
# CARELINK_CIRCUIT_THRESHOLD=5     # consecutive failed fetch() calls before the circuit opens
# CARELINK_CIRCUIT_COOLDOWN_S=60   # seconds the circuit stays open
# CARELINK_STALE_THRESHOLD_MINUTES=15  # minutes without a successful fetch before a STALE warning
# STALE_WEBHOOK_URL=         # if set, POST a JSON alert here when data goes stale
# CARELINK_METRICS_PORT=0    # 0 = disabled (default, no inbound port); e.g. 8081 for loopback-only /healthz + /metrics
