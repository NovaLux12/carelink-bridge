# carelink-bridge environment file
#
# Copy to ~/carelink-bridge/.env (same directory as the service's
# WorkingDirectory) and `chmod 600` it. The systemd unit loads this
# via EnvironmentFile=.
#
# Required:
CARELINK_USERNAME=your-carelink-username
CARELINK_PASSWORD=your-carelink-password
API_SECRET=your-nightscout-api-secret
NS=https://your-nightscout-site.example.com

# Required for US users (default is EU):
# MMCONNECT_SERVER=US

# Optional:
# MMCONNECT_COUNTRYCODE=gb   # default
# MMCONNECT_LANGCODE=en      # default
# MMCONNECT_SERVERNAME=     # optional, blank by default — pins the CareLink hostname explicitly instead of the EU/US default; leave blank unless you need it
# CARELINK_INTERVAL=300      # seconds, default 5 min
# CARELINK_SGV_LIMIT=24      # default
# CARELINK_DATA_PATH=auto    # auto | cumulus | legacy. auto tries display/message then falls back to the legacy chain.
# CARELINK_APP_VERSION=3.8.0 # appVersion in the display/message body. Must be >= 3.7 or you get `206 Upgrade application`.
# CARELINK_ASSUME_TIMEZONE=  # IANA zone, e.g. Europe/London. Set this unless you are certain CareLink
                             # sends a usable clientTimeZoneName: without it an unzoned reading is
                             # interpreted as UTC, so a UK user in BST gets every value shifted an hour.
                             # The warning that says so is logger.log(), i.e. invisible at the default
                             # CARELINK_QUIET=true.
# CARELINK_QUIET=false       # set false for verbose logs
# LOG_FORMAT=pretty          # pretty (default) or json (one JSON per line, for Loki / journalctl -o json)
# CARELINK_PATIENT=          # only if your care-partner account has multiple patients
# CARELINK_STATE_FILE=       # default: <deploy-dir>/state.json (persistent circuit + last-success state, mode 600)
# CARELINK_CIRCUIT_THRESHOLD=5  # consecutive failed fetch() calls before the circuit opens
# CARELINK_CIRCUIT_COOLDOWN_S=60  # seconds the circuit stays open
# CARELINK_STALE_THRESHOLD_MINUTES=15  # minutes without a successful fetch before a STALE warning
# STALE_WEBHOOK_URL=         # if set, POST a JSON alert here when data goes stale
# CARELINK_METRICS_PORT=0    # 0 = disabled (default, no inbound port); e.g. 8081 for loopback-only /healthz + /metrics
